{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Playwright transpiles TS itself at run time and does NOT type-check.
    // This config exists so `npm run typecheck` can catch page-object typos
    // that would otherwise only surface as a failing test.
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
